{
  "name": "copilot-cost-counter",
  "displayName": "Copilot Cost Counter",
  "description": "Record Copilot request usage and cost summaries from its output log.",
  "version": "0.1.11",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "copilotCostCounter.chooseLog",
        "title": "Copilot Cost Counter: Choose Output Log"
      },
      {
        "command": "copilotCostCounter.openUsage",
        "title": "Copilot Cost Counter: Open Workspace Usage"
      },
      {
        "command": "copilotCostCounter.refreshReport",
        "title": "Copilot Cost Counter: Refresh Usage Report"
      },
      {
        "command": "copilotCostCounter.openSettings",
        "title": "Copilot Cost Counter: Open Settings"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "copilotCostCounter.refreshReport",
          "when": "view == copilotCostCounter.report",
          "group": "navigation"
        },
        {
          "command": "copilotCostCounter.openUsage",
          "when": "view == copilotCostCounter.report",
          "group": "navigation"
        },
        {
          "command": "copilotCostCounter.openSettings",
          "when": "view == copilotCostCounter.report",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "copilotCostCounter",
          "title": "Copilot Cost Counter",
          "icon": "$(graph-line)"
        }
      ]
    },
    "views": {
      "copilotCostCounter": [
        {
          "type": "webview",
          "id": "copilotCostCounter.report",
          "name": "Usage Report"
        }
      ]
    },
    "configuration": {
      "title": "Copilot Cost Counter",
      "properties": {
        "copilotCostCounter.logPath": {
          "type": "string",
          "default": "",
          "description": "Path to the GitHub Copilot output log. Leave empty to discover the active VS Code Copilot Chat log automatically."
        },
        "copilotCostCounter.pollIntervalMs": {
          "type": "number",
          "default": 1000,
          "minimum": 250,
          "description": "How often to check the Copilot output log for completed requests."
        },
        "copilotCostCounter.modelPricingOverrides": {
          "type": "object",
          "default": {},
          "description": "Optional per-model USD rates per million tokens. Keys are model names; values may include input, cachedInput, cacheWrite, and output."
        }
      }
    }
  },
  "scripts": {
    "fetch-pricing": "node ./scripts/fetch-pricing.mjs",
    "compile": "npm run fetch-pricing && tsc -p ./tsconfig.json",
    "watch": "tsc -p ./tsconfig.json --watch",
    "package": "npm version patch --no-git-tag-version && npm run compile && mkdir -p packages && vsce package --allow-missing-repository --out packages/copilot-cost-counter-$(node -p \"require('./package.json').version\").vsix"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.0.0"
  }
}
